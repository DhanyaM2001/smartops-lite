# Copy this to `terraform.tfvars` and edit as needed. The real file is
# git-ignored because it may contain owner/region overrides.
#
# In practice, all defaults in variables.tf are good — most of the time you
# don't need a tfvars file at all.

# project            = "smartops-lite"
# env                = "dev"
# region             = "ap-south-1"
# vpc_cidr           = "10.0.0.0/16"
# public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
# instance_type      = "t3.micro"
# root_volume_gb     = 15   # 2 × 15 = 30 GB = EBS free-tier ceiling
