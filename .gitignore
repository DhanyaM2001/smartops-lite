# ─────────── script-generated locals (never commit) ───────────
scripts/.backend-values
scripts/.*.tmp

# ─────────── Logs ───────────
logs/
*.log

# ─────────── Local scratch ───────────
tmp/
scratch/
notes-personal.md

# ─────────── Personal / private study notes (do not upload) ───────────
