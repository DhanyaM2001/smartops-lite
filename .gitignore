# ─────────── Terraform ───────────
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
terraform.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ─────────── AWS / creds ───────────
.aws-credentials
*.pem
*.key
credentials
config-smartops
kubeconfig
kubeconfig.*

# ─────────── Local-only CA certs (never commit) ───────────
# If working behind an SSL-intercepting proxy, CA certs may be copied to
# scripts/ for local trust-store import — must never leave the machine.
# Baking a proxy CA into the repo would contaminate portability.
scripts/*.crt
scripts/*.crt.tmp
scripts/corp-*

# ─────────── Python ───────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
poetry.lock
!apps/*/poetry.lock
!controller/poetry.lock
!lambdas/*/poetry.lock

# ─────────── Node (if we add a small dashboard later) ───────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────── Docker ───────────
docker-compose.override.yml

