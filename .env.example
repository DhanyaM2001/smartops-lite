# .env.example — TEMPLATE
#
# Copy this file to .env and fill in real values on the target machine.
# .env is gitignored — never commit real secrets.
#
# Some scripts (bootstrap-tf-backend.sh, put-secrets.sh, init-repo.sh)
# read variables from environment. You can source this file directly:
#     set -a; source .env; set +a
#
# Or you can `export` each variable manually. The pattern below keeps a
# copy of expected variables in one place for developer convenience.

# ---- AWS ----
# Only used by the scripts as defaults — aws-cli itself reads ~/.aws/credentials.
# Match this to the profile you configured with `aws configure --profile smartops`.
export AWS_PROFILE=smartops
export AWS_REGION=ap-south-1

# ---- Project ----
export PROJECT=smartops-lite
export PROJECT_ENV=dev

# ---- Secrets fed into SSM by scripts/put-secrets.sh ----
# Fill these in ONLY when you're ready to run put-secrets.sh, then unset
# them afterwards. Never commit values into this file.
#
# Better pattern (leaves no trace on disk):
#     read -rs SLACK_WEBHOOK_URL     ; export SLACK_WEBHOOK_URL
#     read -rs GROQ_API_KEY          ; export GROQ_API_KEY
#     read -rs SLACK_SIGNING_SECRET  ; export SLACK_SIGNING_SECRET
#
# SLACK_SIGNING_SECRET is only needed once you reach Module 7 (remediator);
# earlier modules run fine with it empty (put-secrets.sh skips it quietly).
export SLACK_WEBHOOK_URL=
export GROQ_API_KEY=
export SLACK_SIGNING_SECRET=

# ---- GitHub ----
export REPO_NAME=smartops-lite
export REPO_VIS=public
# export REPO_OWNER=DhanyaM2001   # optional; defaults to `gh` auth user
